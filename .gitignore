
build/
.demo-state/
dist/
*.egg-info/
examples/control-plane/docs/dora/deployments.jsonl
.flatpak-build/
.flatpak-builder/
__pycache__/
*.py[cod]
.pytest_cache/
# Rebuilt by `make seed` every time the demo opens.
.ruff_cache/
.venv/
# Written by the console when the demo is used.

# A bare `docker` or `production` pattern in a global excludes file matches these
# inventories by name. Without the negations the examples ship with no hosts.
!examples/control-plane/inventory/docker
!examples/fleet/inventory/production

# The user-level ~/.gitignore is core.excludesFile for every repository under
# $HOME and excludes *.sh outright. Without this negation the release workflow
# fails on a script that was never pushed.
!*.sh

# Disposable output: build products, screenshots, working images, scratch
# notes. Nothing here is reviewed and nothing here is committed.
#
# It carries its own line because the machine this was written on hides it
# through a user-level excludes file, and a clone has none of that.
local.d/
